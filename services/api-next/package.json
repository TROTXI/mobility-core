{
  "name": "@trotxi/api-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replacement backend for the staging API.",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/test-unit.mjs",
    "test:coverage": "node scripts/test-unit.mjs --experimental-test-coverage",
    "test:postgres": "node --import tsx --test --test-concurrency=1 tests/*.pg.test.ts",
    "migrate": "tsx src/db/cli.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/otel": "0.21.1",
    "@fastify/rate-limit": "^11.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@simplewebauthn/server": "14.1.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
