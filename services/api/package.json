{
  "name": "@trotxi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Trotxi transactional API — auth, subscriptions, tokens, mobility.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import ./dist/observability/tracing.live.js dist/server.js",
    "build": "tsup src/server.ts src/observability/tracing.live.ts src/cron/ask-dispatch-cron.ts src/cron/route-learning-cron.ts src/cron/payments-maintenance-cron.ts --format esm --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "tsx src/db/migrate.ts",
    "demo:endpoints": "tsx scripts/endpoint-demo.ts",
    "seed:staging": "tsx scripts/seed-staging.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.219.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/instrumentation-ioredis": "^0.67.0",
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^15.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
